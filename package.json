{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "images": "node scripts/optimize-images.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run build:images && npm run build:client && npm run build:ssr && npm run prerender && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:images": "npm run images || echo '[build] optimize-images no corrio (sharp no disponible); se usan los derivados versionados en client/src/assets/generated y client/public'",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.25",
    "@neondatabase/serverless": "^0.10.4",
    "@types/pg": "^8.20.0",
    "connect-pg-simple": "^10.0.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "memorystore": "^1.6.7",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^21.0.1",
    "wouter": "^3.7.0",
    "ws": "^8.18.0",
    "zod": "^3.24.3",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "20.16.11",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vite": "^6.4.2"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.11"
    },
    "drizzle-kit": {
      "esbuild": "^0.25.11"
    }
  }
}
