# Variables de entorno de chyrris.com.
# Ningún secreto se versiona: este archivo sólo documenta los nombres.
# Copiar a .env (ignorado por git) o definirlas en el panel del proveedor.

# ── Formulario de contacto ──────────────────────────────────────────────────
# Webhook de LeadPrime al que entra cada mensaje como lead.
LEADPRIME_CONTACT_WEBHOOK_URL=

# Correo transaccional (Resend). Sin la clave, el envío por correo se omite y
# el formulario sigue funcionando por el canal de LeadPrime.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
CONTACT_FROM_EMAIL="Chyrris Website <website@chyrris.com>"
CONTACT_TO_EMAIL=info@chyrris.com

# ── Enlaces de tienda del portafolio ────────────────────────────────────────
# Opcionales: si se definen, sobreescriben lo declarado en
# shared/site/portfolio.ts. Un valor vacío hace que el botón de esa tienda
# simplemente no se renderice — nunca se publica un enlace roto.
VITE_STORE_LEADPRIME_IOS=
VITE_STORE_LEADPRIME_ANDROID=
VITE_STORE_TZOTZIL_IOS=
VITE_STORE_TZOTZIL_ANDROID=
VITE_STORE_CAYMUS_IOS=
VITE_STORE_CAYMUS_ANDROID=
VITE_STORE_POCIMA_IOS=
VITE_STORE_POCIMA_ANDROID=
VITE_STORE_MERVIN_IOS=
VITE_STORE_MERVIN_ANDROID=

# ── Caymus Tank Calculator (suscripciones activas — no tocar a la ligera) ───
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
CAYMUS_OWNER_PHONES=
CAYMUS_ADMIN_SECRET=
CAYMUS_SESSION_DURATION_DAYS=30
APPLE_BUNDLE_ID=

# ── Twilio (OTP de Caymus) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Infraestructura ─────────────────────────────────────────────────────────
DATABASE_URL=
PORT=5000
